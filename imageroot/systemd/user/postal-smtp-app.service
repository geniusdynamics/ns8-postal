# Postal SMTP server. postal.yml has no secrets; postal.env (0600) carries them as
# environment variables, which Postal reads over postal.yml. The private
# keys are podman secrets (bin/postal-secrets). The command is the one of
# bin/postal, run without its bash wrapper: the Ruby process is PID 1 and
# stops on SIGTERM instead of being killed after the stop timeout.

[Unit]
Description=Postal SMTP server
BindsTo=postal.service
After=postal.service mariadb-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/postal-smtp-app.pid %t/postal-smtp-app.ctr-id
ExecStartPre=runagent postal-secrets postal-smtp-app
ExecStart=/usr/bin/podman run --conmon-pidfile %t/postal-smtp-app.pid \
    --cidfile %t/postal-smtp-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/postal.pod-id --replace -d --name postal-smtp-app \
    --volume ./postal.yml:/config/postal.yml:z \
    --env-file postal.env \
    --secret postal-smtp-app-signing-key,type=mount,target=signing.key,uid=999,gid=999,mode=0400 \
    --secret postal-smtp-app-tls-cert,type=mount,target=smtp.cert,uid=999,gid=999,mode=0400 \
    --secret postal-smtp-app-tls-key,type=mount,target=smtp.key,uid=999,gid=999,mode=0400 \
    ${POSTAL_IMAGE} bundle exec ruby script/smtp_server.rb
ExecStartPost=runagent postal-wait-ready smtp
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/postal-smtp-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/postal-smtp-app.ctr-id
PIDFile=%t/postal-smtp-app.pid
Type=forking
SyslogIdentifier=%u

[Install]
WantedBy=default.target
