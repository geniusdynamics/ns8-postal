#
# The postal pod: MariaDB, the Postal web server, SMTP server and worker.
# Traefik reaches the web server on 127.0.0.1:${TCP_PORT}; the SMTP server
# (pod port 25) is published on ${POSTAL_SMTP_PORT} of every address of
# the node, opened in the firewall by configure-module.
#

# The pod Wants its containers, they are BindsTo it: starting or stopping
# the pod starts or stops them all, and a container restarts alone. With
# Requires= a restart of one container would restart the whole pod.
[Unit]
Description=Podman postal.service
Wants=mariadb-app.service postal-app.service postal-smtp-app.service postal-worker-app.service
Before=mariadb-app.service postal-app.service postal-smtp-app.service postal-worker-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Environment=POSTAL_SMTP_PORT=2525
EnvironmentFile=-%S/state/environment
WorkingDirectory=%S/state
Restart=always
RestartSec=10
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/postal.pid %t/postal.pod-id
ExecStartPre=/usr/bin/podman pod create --infra-conmon-pidfile %t/postal.pid \
    --pod-id-file %t/postal.pod-id \
    --name postal \
    --publish 127.0.0.1:${TCP_PORT}:5000 \
    --publish ${POSTAL_SMTP_PORT}:25 \
    --replace
ExecStart=/usr/bin/podman pod start --pod-id-file %t/postal.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/postal.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/postal.pod-id
PIDFile=%t/postal.pid
Type=forking

[Install]
WantedBy=default.target
