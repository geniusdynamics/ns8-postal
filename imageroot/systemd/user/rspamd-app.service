# Optional rspamd of Postal, built like the mail-rspamd image of ns8-mail
# (rspamd, Redis, Unbound). It runs in the postal pod, not with the network
# of the node like ns8-mail: its ports (11332-11336) are those of the pod,
# so it never conflicts with the rspamd of ns8-mail on the same node.
# Postal scans on the normal worker, 127.0.0.1:11333 of the pod; the pod
# publishes the controller (11334) on 127.0.0.1:<second TCP port> for Traefik and
# the host-network worker. Started only while rspamd.env exists (the
# rspamd_container setting).

[Unit]
Description=rspamd for Postal
BindsTo=postal.service
After=postal.service
Before=postal-worker-app.service
ConditionPathExists=%S/state/rspamd.env

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=90
ExecStartPre=/bin/rm -f %t/rspamd-app.pid %t/rspamd-app.ctr-id
ExecStart=/usr/bin/podman run \
    --detach \
    --init \
    --conmon-pidfile=%t/rspamd-app.pid \
    --cidfile=%t/rspamd-app.ctr-id \
    --cgroups=no-conmon \
    --pod-id-file=%t/postal.pod-id \
    --replace --name=rspamd-app \
    --env-file=rspamd.env \
    --volume=rspamd-data:/var/lib/rspamd:Z \
    --volume=rspamd-redis:/var/lib/redis:Z \
    --volume=rspamd-override:/etc/rspamd/override.d:z \
    --volume=./rspamd/worker-controller.inc:/etc/rspamd/override.d/worker-controller.inc:ro,z \
    ${POSTAL_RSPAMD_IMAGE}
ExecStartPost=runagent postal-wait-ready rspamd
ExecStop=-/usr/bin/podman exec rspamd-app redis-cli -s /run/redis/persistent.sock save
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/rspamd-app.ctr-id -t 60
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/rspamd-app.ctr-id
ExecReload=/usr/bin/podman exec rspamd-app reload-config
PIDFile=%t/rspamd-app.pid
Type=forking
SyslogIdentifier=%u

[Install]
WantedBy=default.target
