# Postal web server. postal.yml has no secrets; postal.env (0600) carries them as
# environment variables, which Postal reads over postal.yml. The private
# keys are podman secrets (bin/postal-secrets). The command is the one of
# bin/postal, run without its bash wrapper: the Ruby process is PID 1 and
# stops on SIGTERM instead of being killed after the stop timeout.

[Unit]
Description=Postal web server
BindsTo=postal.service
After=postal.service mariadb-app.service
# Started once postal-db-init has created or migrated the schema: on an
# empty database, Postal processes started meanwhile race with
# "postal initialize" on the schema_migrations table
ConditionPathExists=%S/state/.postal-db-ready

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/postal-app.pid %t/postal-app.ctr-id
ExecStartPre=runagent postal-secrets postal-app
ExecStart=/usr/bin/podman run --conmon-pidfile %t/postal-app.pid \
    --cidfile %t/postal-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/postal.pod-id --replace -d --name postal-app \
    --volume ./postal.yml:/config/postal.yml:z \
    --env-file postal.env \
    --secret postal-app-signing-key,type=mount,target=signing.key,uid=999,gid=999,mode=0400 \
    ${POSTAL_IMAGE} bundle exec puma -C config/puma.rb
ExecStartPost=runagent postal-wait-ready web
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/postal-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/postal-app.ctr-id
PIDFile=%t/postal-app.pid
Type=forking
SyslogIdentifier=%u

[Install]
WantedBy=default.target
