# Postal worker. postal.yml has no secrets; postal.env (0600) carries them as
# environment variables, which Postal reads over postal.yml. The private
# keys are podman secrets (bin/postal-secrets).

[Unit]
Description=Postal worker
BindsTo=postal.service
After=postal.service mariadb-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/postal-worker-app.pid %t/postal-worker-app.ctr-id
ExecStartPre=runagent postal-secrets postal-worker-app
ExecStart=/usr/bin/podman run --conmon-pidfile %t/postal-worker-app.pid \
    --cidfile %t/postal-worker-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/postal.pod-id --replace -d --name postal-worker-app \
    --volume ./postal.yml:/config/postal.yml:z \
    --env-file postal.env \
    --secret postal-worker-app-signing-key,type=mount,target=signing.key,uid=999,gid=999,mode=0400 \
    ${POSTAL_IMAGE} postal worker
ExecStartPost=runagent postal-wait-ready worker
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/postal-worker-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/postal-worker-app.ctr-id
PIDFile=%t/postal-worker-app.pid
Type=forking
SyslogIdentifier=%u

[Install]
WantedBy=default.target
