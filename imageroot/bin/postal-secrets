#!/bin/bash

#
# Copyright (C) 2026 Genius Dynamics
# SPDX-License-Identifier: GPL-3.0-or-later
#

#
# ExecStartPre of the Postal containers: give the private keys of the state
# directory (0600 files of the module user) to the container as podman
# secrets, mounted under /run/secrets owned by the postal user (999) of the
# image, mode 0400.
#
# Usage: postal-secrets <container name>
#

set -e
exec 1>&2

container=${1:?container name}

load_secret() {
    podman secret rm "$1" >/dev/null 2>&1 || :
    podman secret create "$1" "$2" >/dev/null
}

# Never leave a stale container referencing the secrets
podman rm --force --ignore "${container}" >/dev/null 2>&1 || :

load_secret "${container}-signing-key" secrets/signing.key

if [[ "${container}" == postal-smtp-app ]]; then
    if [[ -s tls/cert.pem && -s tls/key.pem ]]; then
        load_secret "${container}-tls-cert" tls/cert.pem
        load_secret "${container}-tls-key" tls/key.pem
    else
        # SMTP TLS is off: Postal does not read these
        printf 'none\n' | load_secret "${container}-tls-cert" -
        printf 'none\n' | load_secret "${container}-tls-key" -
    fi
fi
