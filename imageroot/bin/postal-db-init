#!/bin/bash

#
# Copyright (C) 2026 Genius Dynamics
# SPDX-License-Identifier: GPL-3.0-or-later
#

#
# Create or migrate the Postal database schema, with a one-shot Postal
# container in the pod, while mariadb-app runs. "postal initialize" loads
# the schema and would replace the tables of a database in use: run it
# only while the postal database has no tables. Existing instances keep
# their data; their schema migrations run with "postal upgrade". Postal
# processes started meanwhile wait for the migrations (migration_waiter).
#

set -e
exec 1>&2

database=$(sed -n 's/^MARIADB_DATABASE=//p' database.env)
database="${database:-postal}"

# One schema change at a time (configure-module, update, initialize-postal)
exec 9>.postal-db-init.lock
flock 9

# Wait for MariaDB to answer (up to 2 minutes)
for _ in $(seq 1 60); do
    if postal-mariadb mariadb-admin ping -h 127.0.0.1 -u root --silent >/dev/null 2>&1; then
        break
    fi
    sleep 2
done

# Tables of the Postal schema: "postal initialize" (schema load) only on an
# empty database, "postal upgrade" (migrations) otherwise, also after an
# interrupted initialization
tables=$(postal-mariadb mariadb -h 127.0.0.1 -u root -N -B \
    -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${database}' AND table_name <> 'schema_migrations'")

if [[ "${tables}" == 0 ]]; then
    echo "Empty postal database: creating the Postal schema"
    command=initialize
else
    echo "The postal database has ${tables} tables: running the Postal migrations"
    command=upgrade
fi

exec podman run --rm --name postal-db-init --replace \
    --pod postal \
    --volume ./postal.yml:/config/postal.yml:z \
    --env-file postal.env \
    --env MIGRATION_WAITER_ENABLED=false \
    "${POSTAL_IMAGE}" postal "${command}"
