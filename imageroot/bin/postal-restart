#

#
# Restart the postal pod and every container, by name. The Postal schema
# is created or migrated (postal-db-init) once MariaDB answers and before
# the Postal processes are waited for: they wait for the migrations.
#
# Usage: postal-restart [--if-active]
#

set -e
exec 1>&2

if [[ "$1" == "--if-active" ]] && ! systemctl --user -q is-active postal.service; then
    echo "postal.service is not running: not restarted"
    exit 0
fi

# A full restart applies every pending change
rm -f .restart-set.json
systemctl --user restart postal.service mariadb-app.service
postal-db-init
# rspamd-app and clamav-app start only while their setting is on
systemctl --user start rspamd-app.service clamav-app.service postal-app.service postal-smtp-app.service postal-worker-app.service
