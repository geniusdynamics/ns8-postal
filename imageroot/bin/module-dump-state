#!/bin/bash

#
# Copyright (C) 2022 Nethesis S.r.l.
# SPDX-License-Identifier: GPL-3.0-or-later
#

#
# Dump every Postal database before the backup: the main database
# ("postal") and the message database of each mail server
# ("postal-server-<id>").
#

set -e -o pipefail
exec 1>&2

if ! systemctl --user -q is-active mariadb-app.service; then
	echo "mariadb-app is not running: no database dump"
	exit 0
fi

set -a
source ./database.env
set +a

prefix="${MARIADB_DATABASE:-postal}"
mapfile -t databases < <(podman exec -e MYSQL_PWD="${MARIADB_ROOT_PASSWORD}" mariadb-app \
	mariadb -h 127.0.0.1 -u root -N -B \
	-e "SELECT schema_name FROM information_schema.schemata WHERE schema_name = '${prefix}' OR schema_name LIKE '${prefix}-server-%'")

if [[ ${#databases[@]} -eq 0 ]]; then
	echo "No Postal database to dump"
	exit 0
fi

echo "Dumping databases: ${databases[*]}"
podman exec -e MYSQL_PWD="${MARIADB_ROOT_PASSWORD}" mariadb-app mariadb-dump \
	-h 127.0.0.1 -u root \
	--databases "${databases[@]}" \
	--default-character-set=utf8mb4 \
	--skip-dump-date \
	--single-transaction \
	--quick \
	--routines \
	--add-drop-table >postal.sql.tmp
mv -f postal.sql.tmp postal.sql
chmod 0600 postal.sql
