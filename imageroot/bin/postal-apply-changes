#
# 80start_services of configure-module: restart only the containers the
# configuration change affects (the restart set written by the previous
# steps, see postal_ns8.RESTART_MAP). A pod that is not running, or a
# change of the pod itself (the ports it publishes), restarts everything
# with postal-restart. MariaDB restarts only then. The optional rspamd and
# ClamAV containers start or stop with their setting.
#

import os
import subprocess
import sys
import postal_ns8 as postal


def systemctl(*args):
    return subprocess.run(["systemctl", "--user", *args]).returncode


names = postal.take_restart_set()
active = systemctl("-q", "is-active", "postal.service") == 0

if not active or postal.POD in names:
    postal.log(f"Restarting the whole pod ({'not running' if not active else 'pod settings changed'})")
    sys.exit(subprocess.run(["postal-restart"]).returncode)

# Optional containers first: the worker of the restart set uses them
for name, (unit, flag) in postal.OPTIONAL_UNITS.items():
    if not os.path.exists(flag):
        systemctl("stop", unit)
    elif name in names:
        postal.log(f"Restarting {unit}")
        if systemctl("restart", unit) != 0:
            sys.exit(1)
    else:
        systemctl("start", unit)

units = [postal.UNITS[name] for name in sorted(names) if name in postal.UNITS]
if units:
    postal.log("Restarting " + " ".join(units))
    if systemctl("restart", *units) != 0:
        sys.exit(1)
else:
    postal.log("No Postal process is affected by the change: nothing restarted")
# Containers stopped for another reason start again
sys.exit(systemctl("start", *postal.UNITS.values()))
