{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get postal settings",
    "$id": "http://nethserver.org/json-schema/task/output/postal/get-configuration",
    "description": "Get postal settings, without secrets",
    "examples": [
        {
            "host": "postal.domain.org",
            "http2https": true,
            "lets_encrypt": true,
            "oidc_secret_set": false
        }
    ],
    "type": "object",
    "required": [
        "host",
        "http2https",
        "lets_encrypt",
        "oidc_secret_set",
        "app_smtp_password_set",
        "rspamd_password_set",
        "sentry_dsn_set"
    ],
    "not": {
        "anyOf": [
            {
                "required": [
                    "oidc_secret"
                ]
            },
            {
                "required": [
                    "app_smtp_password"
                ]
            },
            {
                "required": [
                    "rspamd_password"
                ]
            },
            {
                "required": [
                    "sentry_dsn"
                ]
            }
        ]
    },
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name of the web interface"
        },
        "http2https": {
            "type": "boolean",
            "description": "Redirect all the HTTP requests to HTTPS"
        },
        "lets_encrypt": {
            "type": "boolean",
            "description": "Request a valid Let's Encrypt certificate"
        },
        "smtp_hostname": {
            "type": "string",
            "description": "Host name of the SMTP server (empty: the host name of the web interface)"
        },
        "smtp_port": {
            "type": "integer",
            "description": "Node TCP port of the SMTP server (pod port 25), opened in the firewall"
        },
        "smtp_tls": {
            "type": "boolean",
            "description": "Offer STARTTLS with the Traefik certificate of the SMTP host name"
        },
        "max_message_size": {
            "type": "integer"
        },
        "smtp_log_connections": {
            "type": "boolean"
        },
        "use_ip_pools": {
            "type": "boolean",
            "description": "POSTAL_USE_IP_POOLS: enable the IP pools of Postal"
        },
        "default_maximum_delivery_attempts": {
            "type": "integer"
        },
        "default_maximum_hold_expiry_days": {
            "type": "integer"
        },
        "default_suppression_list_automatic_removal_days": {
            "type": "integer"
        },
        "default_spam_threshold": {
            "type": "integer"
        },
        "default_spam_failure_threshold": {
            "type": "integer"
        },
        "use_resent_sender_header": {
            "type": "boolean"
        },
        "helo_hostname": {
            "type": "string"
        },
        "batch_queued_messages": {
            "type": "boolean"
        },
        "queued_message_lock_stale_days": {
            "type": "integer"
        },
        "smtp_client_open_timeout": {
            "type": "integer"
        },
        "smtp_client_read_timeout": {
            "type": "integer"
        },
        "smtp_relays": {
            "type": "array",
            "maxItems": 10,
            "items": {
                "type": "object",
                "required": [
                    "host"
                ],
                "properties": {
                    "host": {
                        "type": "string"
                    },
                    "port": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                    },
                    "ssl_mode": {
                        "type": "string",
                        "enum": [
                            "Auto",
                            "STARTTLS",
                            "TLS",
                            "None"
                        ]
                    }
                }
            },
            "description": "POSTAL_SMTP_RELAYS: send every message through these relays"
        },
        "relay_via_cluster_smarthost": {
            "type": "boolean",
            "description": "Send every message through the NS8 cluster smarthost (it must accept mail without authentication)"
        },
        "cluster_relay_provider": {
            "type": "boolean",
            "description": "Offer Postal as smarthost of the cluster (requires smtp_port 25)"
        },
        "app_smtp_mode": {
            "type": "string",
            "description": "SMTP server of the e-mails of Postal itself: the cluster smarthost or a custom one",
            "enum": [
                "smarthost",
                "custom"
            ]
        },
        "app_smtp_host": {
            "type": "string"
        },
        "app_smtp_port": {
            "type": "integer"
        },
        "app_smtp_username": {
            "type": "string"
        },
        "app_smtp_tls": {
            "type": "string",
            "enum": [
                "starttls_auto",
                "starttls",
                "none"
            ]
        },
        "app_smtp_tls_verify": {
            "type": "boolean"
        },
        "from_name": {
            "type": "string"
        },
        "from_address": {
            "type": "string"
        },
        "oidc_provider": {
            "type": "string",
            "description": "Selected NS8 OIDC provider module UUID, or empty for manual setup"
        },
        "oidc_domain": {
            "type": "string",
            "description": "NS8 user domain used for automatic client registration"
        },
        "oidc_enabled": {
            "type": "boolean"
        },
        "oidc_name": {
            "type": "string"
        },
        "oidc_issuer": {
            "type": "string"
        },
        "oidc_identifier": {
            "type": "string"
        },
        "oidc_scopes": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "oidc_uid_field": {
            "type": "string"
        },
        "oidc_email_address_field": {
            "type": "string"
        },
        "oidc_name_field": {
            "type": "string"
        },
        "oidc_discovery": {
            "type": "boolean"
        },
        "oidc_authorization_endpoint": {
            "type": "string"
        },
        "oidc_token_endpoint": {
            "type": "string"
        },
        "oidc_userinfo_endpoint": {
            "type": "string"
        },
        "oidc_jwks_uri": {
            "type": "string"
        },
        "oidc_local_authentication_enabled": {
            "type": "boolean",
            "description": "Local logins: can be disabled only with OIDC enabled"
        },
        "rspamd_enabled": {
            "type": "boolean"
        },
        "rspamd_host": {
            "type": "string"
        },
        "rspamd_port": {
            "type": "integer"
        },
        "rspamd_ssl": {
            "type": "boolean"
        },
        "rspamd_flags": {
            "type": "string"
        },
        "spamd_enabled": {
            "type": "boolean"
        },
        "spamd_host": {
            "type": "string"
        },
        "spamd_port": {
            "type": "integer"
        },
        "clamav_enabled": {
            "type": "boolean"
        },
        "clamav_host": {
            "type": "string"
        },
        "clamav_port": {
            "type": "integer"
        },
        "dns_mx_records": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "dns_spf_include": {
            "type": "string"
        },
        "dns_return_path_domain": {
            "type": "string"
        },
        "dns_route_domain": {
            "type": "string"
        },
        "dns_track_domain": {
            "type": "string"
        },
        "dns_dkim_identifier": {
            "type": "string"
        },
        "dns_custom_return_path_prefix": {
            "type": "string"
        },
        "dns_domain_verify_prefix": {
            "type": "string"
        },
        "use_local_ns_for_domain_verification": {
            "type": "boolean"
        },
        "web_server_max_threads": {
            "type": "integer"
        },
        "worker_threads": {
            "type": "integer"
        },
        "main_db_pool_size": {
            "type": "integer"
        },
        "logging_enabled": {
            "type": "boolean"
        },
        "rails_log_enabled": {
            "type": "boolean"
        },
        "gelf_host": {
            "type": "string"
        },
        "gelf_port": {
            "type": "integer"
        },
        "gelf_facility": {
            "type": "string"
        },
        "trusted_proxies": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "allowed_request_destinations": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "oidc_secret_set": {
            "type": "boolean",
            "description": "True if oidc_secret is stored (the value is never returned)"
        },
        "app_smtp_password_set": {
            "type": "boolean",
            "description": "True if app_smtp_password is stored (the value is never returned)"
        },
        "rspamd_password_set": {
            "type": "boolean",
            "description": "True if rspamd_password is stored (the value is never returned)"
        },
        "sentry_dsn_set": {
            "type": "boolean",
            "description": "True if sentry_dsn is stored (the value is never returned)"
        },
        "oidc_redirect_uri": {
            "type": "string"
        },
        "smtp_hostname_effective": {
            "type": "string"
        },
        "cluster_network": {
            "type": "string"
        },
        "node_address": {
            "type": "string"
        },
        "configured": {
            "type": "boolean"
        },
        "dns": {
            "type": "object"
        },
        "cluster_smarthost": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "host": {
                    "type": "string"
                },
                "port": {
                    "type": "integer"
                },
                "authenticated": {
                    "type": "boolean"
                },
                "encrypt_smtp": {
                    "type": "string"
                }
            }
        },
        "warnings": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "track_domains": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "no_lets_encrypt",
                            "pending",
                            "obtained",
                            "used_by_another_route"
                        ]
                    }
                }
            }
        },
        "smtp_port_choices": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "port": {
                        "type": "integer"
                    },
                    "used_by": {
                        "type": "string"
                    }
                }
            }
        },
        "worker_host_network": {
            "type": "boolean",
            "description": "Run the Postal worker with the network of the node (--network=host), so the IP pools can bind any address of the node"
        },
        "rspamd_container": {
            "type": "boolean",
            "description": "Run rspamd in the pod and let Postal use it"
        },
        "rspamd_webui": {
            "type": "boolean",
            "description": "Publish the rspamd web interface on https://<host>/rspamd (requires rspamd_container)"
        },
        "clamav_container": {
            "type": "boolean",
            "description": "Run ClamAV in the pod and let Postal use it (about 1 GB of memory)"
        },
        "rspamd_webui_route": {
            "type": "object",
            "description": "State of the Traefik route of the rspamd web interface; owner is the conflicting route",
            "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                        "published",
                        "off",
                        "conflict"
                    ]
                },
                "owner": {
                    "type": "string"
                }
            }
        }
    }
}