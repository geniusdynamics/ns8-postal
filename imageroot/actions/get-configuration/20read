# Return every setting, without secrets: the write-only secrets are
# reported as *_set booleans. Also the values the UI shows: the OIDC
# redirect URI, the DNS records, the cluster smarthost and network.

import json
import os
import sys
import agent
import postal_ns8 as postal

settings = postal.coerce(postal.load_settings())
sec = postal.read_secrets()
config = postal.configure_payload(settings, settings["lets_encrypt"])

for field, var in postal.SECRET_FIELDS.items():
    config[field + "_set"] = bool(sec.get(var))

dns = postal.dns_names(settings)
network, node_address = postal.cluster_info()
sh = postal.smarthost()
config.update({
    "configured": os.path.exists(postal.SETTINGS_FILE),
    "smtp_hostname_effective": postal.smtp_hostname(settings),
    "oidc_redirect_uri": postal.oidc_redirect_uri(settings),
    "dns": {
        "mx_records": dns["mx_records"],
        "spf_include": dns["spf_include"],
        "return_path_domain": dns["return_path_domain"],
        "route_domain": dns["route_domain"],
        "track_domain": dns["track_domain"],
        "web_host": settings["host"],
    },
    "cluster_network": network,
    "node_address": node_address,
    "cluster_smarthost": {
        "enabled": bool(sh["enabled"] and sh["host"]),
        "host": sh["host"],
        "port": int(sh["port"] or 0),
        "authenticated": bool(sh["username"]),
        "encrypt_smtp": sh["encrypt_smtp"],
    },
})
try:
    with open(".configure-warnings.json") as fp:
        config["warnings"] = json.load(fp)
except (FileNotFoundError, ValueError):
    config["warnings"] = []

json.dump(config, fp=sys.stdout)
