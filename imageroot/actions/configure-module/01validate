# Validate the settings, merged over the current ones: fields left out of
# the request keep their value. Like ns8-mailcow and ns8-kumomta, refuse an
# SMTP port of another mail module of the node or held by another service.

import json
import os
import sys
import agent
import postal_ns8 as postal

agent.set_weight(os.path.basename(__file__), 0)  # Validation step, no task progress at all

data = json.load(sys.stdin)
postal.migrate_legacy()
current, settings, updates = postal.merge_request(data)
errors = postal.validate(data, current, settings, updates)
if errors:
    agent.set_status('validation-failed')
    json.dump(errors, fp=sys.stdout)
    sys.exit(3)
