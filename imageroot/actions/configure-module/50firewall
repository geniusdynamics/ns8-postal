# Open the SMTP port of the pod on the node firewall, like ns8-mail

import os
import agent
import postal_ns8 as postal

settings = postal.load_settings()
agent.assert_exp(agent.add_public_service(os.environ['MODULE_ID'], [f"{settings['smtp_port']}/tcp"], replace_ports=True),
                 "add-public-service failed")
