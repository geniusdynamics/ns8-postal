# Store the settings (state/settings.json) and the write-only secrets
# (state/secrets/secrets.env, 0600). Only non-secret values go to the
# module environment.

import json
import sys
import agent
import postal_ns8 as postal

data = json.load(sys.stdin)
current, settings, updates = postal.merge_request(data)
postal.save_settings(settings)
if updates:
    sec = postal.read_secrets()
    sec.update(updates)
    postal.write_secrets(sec)

agent.set_env("TRAEFIK_HOST", settings["host"])
agent.set_env("TRAEFIK_HTTP2HTTPS", settings["http2https"])
agent.set_env("TRAEFIK_LETS_ENCRYPT", settings["lets_encrypt"])
agent.set_env("POSTAL_SMTP_PORT", settings["smtp_port"])
agent.set_env("POSTAL_SMTP_HOSTNAME", postal.smtp_hostname(settings))
