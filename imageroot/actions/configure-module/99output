# Return the warnings of the rendering (e.g. the cluster smarthost is off)

import json
import sys

try:
    with open(".configure-warnings.json") as fp:
        warnings = json.load(fp)
except (FileNotFoundError, ValueError):
    warnings = []
json.dump({"warnings": warnings}, fp=sys.stdout)
