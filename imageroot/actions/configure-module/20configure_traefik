# Route the web interface: Traefik terminates HTTPS and forwards to the
# pod port 5000, published on 127.0.0.1:${TCP_PORT}

import os
import agent
import agent.tasks
import postal_ns8 as postal

settings = postal.load_settings()
response = agent.tasks.run(
    agent_id=agent.resolve_agent_id('traefik@node'),
    action='set-route',
    data={
        'instance': os.environ['MODULE_ID'],
        'url': 'http://127.0.0.1:' + os.environ["TCP_PORT"],
        'host': settings["host"],
        'http2https': settings["http2https"],
        'lets_encrypt': settings["lets_encrypt"],
        'headers': {"request": {"X-Forwarded-Proto": "https"}},
    },
)
agent.assert_exp(response['exit_code'] == 0, "set-route failed")
