# Render postal.yml (no secrets) and postal.env (0600, the secrets as
# environment variables, which Postal reads over postal.yml)

import json
import postal_ns8 as postal

affected, warnings = postal.render(postal.load_settings())
postal.log(f"configure-module: containers to restart: {sorted(affected) or 'none'}")
for warning in warnings:
    postal.log(f"configure-module warning: {warning}")
postal.write_file(".configure-warnings.json", json.dumps(warnings) + "\n", 0o644)
