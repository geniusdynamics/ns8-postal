# Generate the secrets of a new instance in 0600 files, never in the
# module environment (Redis): the MariaDB passwords, the Rails secret key
# and the Postal signing key.

import os
import secrets
import agent
import postal_ns8 as postal

if not os.path.exists(postal.DATABASE_ENV):
    postal.write_env(postal.DATABASE_ENV, {
        "MARIADB_ROOT_PASSWORD": secrets.token_hex(24),
        "MARIADB_DATABASE": "postal",
        "MARIADB_USER": "postal",
        "MARIADB_PASSWORD": secrets.token_hex(24),
    })

if not os.path.exists(postal.SECRETS_ENV):
    postal.write_secrets({"RAILS_SECRET_KEY": secrets.token_hex(64)})

if not os.path.exists(postal.SIGNING_KEY):
    postal.generate_signing_key()

agent.set_env("POSTAL_SMTP_PORT", postal.DEFAULTS["smtp_port"])
