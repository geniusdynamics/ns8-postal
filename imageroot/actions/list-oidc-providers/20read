# NS8 OIDC discovery, manual issuer presets, and the available user domains.

import json
import sys
import agent
from agent.ldapproxy import Ldapproxy
import postal_ns8 as postal

try:
    providers = postal.oidc_providers()
except Exception as ex:
    print(agent.SD_WARNING + f"Cannot list the OIDC providers: {ex}", file=sys.stderr)
    providers = []
try:
    domains = sorted(Ldapproxy().get_domains_list())
except Exception as ex:
    print(agent.SD_WARNING + f"Cannot list NS8 user domains: {ex}", file=sys.stderr)
    domains = []
json.dump({"providers": providers, "domains": domains}, fp=sys.stdout)
