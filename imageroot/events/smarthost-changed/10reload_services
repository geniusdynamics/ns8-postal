# The cluster smarthost changed: render the configuration again if Postal
# uses it (e-mails of Postal itself, or relay of the outgoing mail) and
# restart the Postal processes that read it

import agent
import os
import postal_ns8 as postal

if not os.path.exists(postal.SETTINGS_FILE):
    raise SystemExit(0)

settings = postal.load_settings()
if not postal.depends_on_smarthost(settings):
    raise SystemExit(0)

changed, warnings = postal.render(settings)
for warning in warnings:
    postal.log(f"smarthost-changed warning: {warning}")
if changed:
    agent.run_helper('systemctl', '--user', '-T', 'try-restart',
                     'postal-app.service', 'postal-smtp-app.service', 'postal-worker-app.service')
