# Traefik obtained or renewed a certificate: if it is the one of the SMTP
# host name, give it to the Postal SMTP server, like ns8-mail does

import json
import os
import sys
import agent
import postal_ns8 as postal

event = json.load(sys.stdin)
if not os.path.exists(postal.SETTINGS_FILE):
    sys.exit(0)
settings = postal.load_settings()
name = postal.smtp_hostname(settings)
if not settings["smtp_tls"] or not name or not agent.certificate_event_matches(event, name):
    sys.exit(0)  # ignore event if not relevant

if postal.fetch_certificate(name):
    postal.render(settings)  # TLS turns on with the first certificate
    agent.run_helper('systemctl', '--user', '-T', 'try-restart', 'postal-smtp-app.service')
